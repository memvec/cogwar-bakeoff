# Telegram API credentials — obtain from https://my.telegram.org
# (log in -> API development tools -> create an app)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=cogwar_collect
TELEGRAM_PHONE=

# YouTube Data API v3 key — obtain from
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data
# API v3" on the project first)
YOUTUBE_API_KEY=

# Anthropic API key (analysis layer: entity extraction) — obtain from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API key (analysis layer: alternative provider behind the same
# interfaces, --provider gemini) — obtain from https://aistudio.google.com/apikey.
# Use a PAID-TIER key: Google's free tier trains on submitted data.
GEMINI_API_KEY=
